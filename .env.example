# Copy to .env for local testing only — Railway env vars are set in its
# dashboard, not from this file.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...           # service_role key — NEVER the anon key, and never exposed to the frontend
ADMIN_API_KEY=choose-a-long-random-string  # pasted into the admin page's session storage, never hardcoded anywhere
ALLOWED_ORIGIN=https://buniipad.xyz,http://localhost:5173
PORT=3001
